# Atlas HUB — git ignores
# El repo raíz YA es el HUB (no subcarpeta). Solo se versiona código + docs +
# estado fuente de verdad (briefs/consensos con frontmatter). No runtime locks.

# Mac metadata
._*
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Graphify / Obsidian
graphify-out/
.obsidian/

# Hub runtime state (no versionar locks/seen en vivo; briefs/consensos SÍ)
.processing/
.seen/
.seen.log
mail/

# Secrets
.env
*.key
